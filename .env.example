NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# Auth
JWT_SECRET=dev-secret-change-in-production
AUDIT_SERVICE_URL=http://localhost:3009

# Database
DATABASE_URL=postgresql://campuscast:campuscast@localhost:5432/content_db

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint for presigned upload URLs (set in Docker to http://localhost:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campuscast-content
SIGNING_KMS_URL=http://localhost:3008

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9464
